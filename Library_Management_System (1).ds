                 		Member_Status="Inactive"
                 	]
                 	info "Books: " + Books[ID != 0].count() + " | Members: " + Members[ID != 0].count();
                 }
				 void markOverdueIssues()
                 {
                 	// mark every unreturned issue whose due date has passed as Overdue
                 	count = 0;
                 	for each  rec in Book_Issues[Issue_Status == "Issued" && Due_Date < zoho.currentdate]
                 	{
                 		rec.Issue_Status="Overdue";
                 		count = count + 1;
                 	}
                 	info "Issues marked Overdue: " + count;
                 }
				 void stockCheck()
                 {
                 	// verify: Available Copies = Total Copies - copies not yet returned
                 	for each  bk in Books[ID != 0] sort by Book_ID
                 	{
                 		out = Book_Issues[Book == bk.ID && Issue_Status != "Returned"].count();
                 		if(bk.Total_Copies - out == bk.Available_Copies)
                 		{
                 			chk = "OK";
                 		}
                 		else
                 		{
                 			chk = "MISMATCH";
                 		}
                 		info bk.Book_Title + " | Total: " + bk.Total_Copies + " | Issued: " + out + " | Available: " + bk.Available_Copies + " | " + chk;
                 	}
                 }
			 }
		 }


		workflow
		{
		form
		{
			Validate_Book_Copies as "Validate Book Copies"
			{
				type =  form
				form = Books

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Books - validation on form submission (Created or Edited)
										if(input.Total_Copies == null || input.Total_Copies <= 0)
										{
											alert "Total Copies must be greater than zero.";
											cancel submit;
										}
										if(input.Available_Copies != null && input.Available_Copies < 0 || input.Available_Copies > input.Total_Copies)
										{
											alert "Available Copies must be between 0 and Total Copies (" + input.Total_Copies + ").";
											cancel submit;
										}
						)
					}
				}

			}
			Set_Available_Copies as "Set Available Copies"
			{
				type =  form
				form = Books

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Books - on successful submission (Created): new book starts with all copies available
										if(input.Available_Copies == null)
										{
											input.Available_Copies = input.Total_Copies;
										}
						)
					}
				}

			}
			Default_Registration_Date as "Default Registration Date"
			{
				type =  form
				form = Members

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Members - on load (Created): registration date defaults to today
										input.Registration_Date = zoho.currentdate;
						)
					}
				}

			}
			Default_Issue_and_Due_Dat as "Default Issue and Due Date"
			{
				type =  form
				form = Book_Issues

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Book Issues - on load (Created): default issue date and 14-day due date
										input.Issue_Date = zoho.currentdate;
										input.Due_Date = zoho.currentdate.addDay(14);
										input.Issue_Status = "Issued";
						)
					}
				}

			}
			Calculate_Due_Date as "Calculate Due Date"
			{
				type =  form
				form = Book_Issues

				record event = on add or edit

				on user input of Issue_Date
				{
					actions 
					{
						custom deluge script
						(
											// Book Issues - on user input of Issue Date: due date = issue date + 14 days
										if(input.Issue_Date != null)
										{
											input.Due_Date = input.Issue_Date.addDay(14);
										}
						)
					}
				}

			}
			Validate_Book_Issue as "Validate Book Issue"
			{
				type =  form
				form = Book_Issues

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Book Issues - validation when a book is issued (Created)
										mem = Members[ID == input.Member];
										if(mem.Member_Status != "Active")
										{
											alert "Member " + mem.Full_Name + " is Inactive. Books can be issued only to active members.";
											cancel submit;
										}
										bk = Books[ID == input.Book];
										if(bk.Available_Copies == null || bk.Available_Copies <= 0)
										{
											alert "No copies of '" + bk.Book_Title + "' are available. The book cannot be issued.";
											cancel submit;
										}
										if(input.Return_Date != null)
										{
											alert "Return Date cannot be entered while issuing a book.";
											cancel submit;
										}
										if(input.Due_Date != null && input.Due_Date < input.Issue_Date)
										{
											alert "Due Date cannot be before the Issue Date.";
											cancel submit;
										}
						)
					}
				}

			}
			Reduce_Stock_on_Issue as "Reduce Stock on Issue"
			{
				type =  form
				form = Book_Issues

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Book Issues - after a successful issue (Created): reduce stock by exactly one
										bk = Books[ID == input.Book];
										bk.Available_Copies=bk.Available_Copies - 1;
										if(input.Due_Date == null)
										{
											input.Due_Date = input.Issue_Date.addDay(14);
										}
										if(input.Due_Date < zoho.currentdate)
										{
											input.Issue_Status = "Overdue";
										}
										else
										{
											input.Issue_Status = "Issued";
										}
						)
					}
				}

			}
			Validate_Book_Return as "Validate Book Return"
			{
				type =  form
				form = Book_Issues

				record event = on edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Book Issues - validation when an issue record is edited (return of a book)
										prev = Book_Issues[ID == input.ID];
										if(prev.Book != input.Book || prev.Member != input.Member)
										{
											alert "Member and Book cannot be changed after the book is issued.";
											cancel submit;
										}
										if(prev.Issue_Status == "Returned")
										{
											alert "This book was already returned on " + prev.Return_Date + ". The return cannot be recorded again.";
											cancel submit;
										}
										if(input.Issue_Status == "Returned" && input.Return_Date == null)
										{
											alert "Enter the Return Date to mark the book as Returned.";
											cancel submit;
										}
										if(input.Return_Date != null && input.Return_Date < input.Issue_Date)
										{
											alert "Return Date cannot be before the Issue Date.";
											cancel submit;
										}
										// valid return: increase stock by exactly one (once only - a returned record is locked above)
										if(input.Return_Date != null)
										{
											bk = Books[ID == input.Book];
											if(bk.Available_Copies < bk.Total_Copies)
											{
												bk.Available_Copies=bk.Available_Copies + 1;
											}
										}
						)
					}
				}

			}
			Update_Status_on_Return as "Update Status on Return"
			{
				type =  form
				form = Book_Issues

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Book Issues - after a successful edit: set the correct status
										if(input.Return_Date != null)
										{
											input.Issue_Status = "Returned";
											if(input.Return_Date > input.Due_Date)
											{
												input.Single_Line = "Returned late (" + input.Due_Date.daysBetween(input.Return_Date) + " days after due date)";
											}
											else
											{
												input.Single_Line = "Returned on time";
											}
										}
										else if(input.Due_Date < zoho.currentdate)
										{
											input.Issue_Status = "Overdue";
										}
										else
										{
											input.Issue_Status = "Issued";
										}
						)
					}
				}

			}
			Restore_Stock_on_Delete as "Restore Stock on Delete"
			{
				type =  form
				form = Book_Issues

				record event = on delete

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Book Issues - before deletion: give the copy back if the book was never returned
										if(input.Issue_Status != "Returned")
										{
											bk = Books[ID == input.Book];
											if(bk.Available_Copies < bk.Total_Copies)
											{
												bk.Available_Copies=bk.Available_Copies + 1;
											}
										}
						)
					}
				}

			}
		}






	}
