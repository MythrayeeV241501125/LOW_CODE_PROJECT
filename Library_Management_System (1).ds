                 		Author="Harper Lee"
                 		Category="Fiction"
                 		Publisher="Harper Perennial"
                 		Total_Copies=2
                 		Available_Copies=2
                 		Single_Line="F-01"
                 	]
                 	insert into Books
                 	[
                 		Added_User=zoho.loginuser
                 		ISBN="9780451524935"
                 		Book_Title="1984"
                 		Author="George Orwell"
                 		Category="Fiction"
                 		Publisher="Signet Classics"
                 		Total_Copies=1
                 		Available_Copies=1
                 		Single_Line="F-02"
                 	]
                 	insert into Members
                 	[
                 		Added_User=zoho.loginuser
                 		Full_Name="Arun Kumar"
                 		Roll_Number="241501001"
                 		Email="arun.k@example.com"
                 		Phone="9876543201"
                 		Department="CSE"
                 		Registration_Date="01-Jul-2026".toDate()
                 		Member_Status="Active"
                 	]
                 	insert into Members
                 	[
