 application "Library Management System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Book_Issues
		{
			displayname = "Book Issues"
			success message = "Book issue recorded successfully!"
			Section
			(
				type = section
				displayname = "Issue Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Issue_ID
			(
    			type = autonumber
				displayname = "Issue ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Member
			(
				type = picklist	
				values  = Members.ID
    			displayformat = [Full_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Book
			(
				type = picklist	
				values  = Books.ID
    			displayformat = [Book_Title]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Issue_Date
			(
    			type = date
				displayname = "Issue Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Due_Date
			(
    			type = date
				displayname = "Due Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Return_Details
			(
				type = section
				displayname = "Return Details"
	 			row = 2
	 			column = 0   
				width = medium
			)
			Return_Date
			(
    			type = date
				displayname = "Return Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 1   
				width = medium
			)
			Issue_Status
			(
				type = picklist
				displayname = "Issue Status"
				values = {"Issued","Returned","Overdue"}
				initial value = "Issued"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Single_Line
			(
    			type = text
				displayname = "Remarks"
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Books
		{
			success message = "Book saved successfully!"
			Section
			(
				type = section
				displayname = "Book Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Book_ID
			(
    			type = autonumber
				displayname = "Book ID"
				start index = 101
	 			row = 1
	 			column = 1   
				width = medium
			)
			unique ISBN
			(
    			type = text
				maxchar = 20
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Book_Title
			(
    			type = text
				displayname = "Book Title"
				maxchar = 150
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Author
			(
    			type = text
				maxchar = 100
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Category
			(
				type = picklist
				values = {"Fiction","Science","Technology","History","General"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Publisher
			(
    			type = text
				maxchar = 100
	 			row = 1
	 			column = 1   
				width = medium
			)
			Stock_Details
			(
				type = section
				displayname = "Stock Details"
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have Total_Copies
			(
				type = number
				displayname = "Total Copies"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Available_Copies
			(
				type = number
				displayname = "Available Copies"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Single_Line
			(
    			type = text
				displayname = "Shelf Location"
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Members
		{
			success message = "Member registered successfully!"
			Section
			(
				type = section
				displayname = "Member Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Member_ID
			(
    			type = autonumber
				displayname = "Member ID"
				start index = 1001
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Full_Name
			(
    			type = text
				displayname = "Full Name"
				maxchar = 100
	 			row = 1
	 			column = 1   
				width = medium
			)
			unique Roll_Number
			(
    			type = text
				displayname = "Roll Number"
				maxchar = 20
	 			row = 1
	 			column = 1   
				width = medium
			)
			Email
			(
    			type = email
				maxchar = 100
	 			row = 1
	 			column = 1   
				width = medium
			)
			Phone
			(
    			type = phonenumber
				displayname = "Phone Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Department
			(
				type = picklist
				values = {"CSE","AIML","ECE","IT","MECH","EEE"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Single_Line
			(
    			type = text
				displayname = "Address"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Membership
			(
				type = section
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have Registration_Date
			(
    			type = date
				displayname = "Registration Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have Member_Status
			(
				type = picklist
				displayname = "Member Status"
				values = {"Active","Inactive"}
				initial value = "Active"
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		default list All_Books
		{
			displayName = "Book Catalogue"
			show all rows from Books    
			(
				Book_ID as "Book ID"
				ISBN
				Book_Title as "Book Title"
				Author
				Category
				Publisher
				Total_Copies as "Total Copies"
				Available_Copies as "Available Copies"
				Single_Line as "Shelf Location"
			)
		}
		default list All_Members
		{
			displayName = "Member List"
			show all rows from Members    
			(
				Member_ID as "Member ID"
				Full_Name as "Full Name"
				Roll_Number as "Roll Number"
				Department
				Email
				Phone as "Phone Number"
				Registration_Date as "Registration Date"
				Member_Status as "Member Status"
			)
		}
		default list All_Book_Issues
		{
			displayName = "Issue Register"
			show all rows from Book_Issues    
			(
				Issue_ID as "Issue ID"
				Member
				Book
				Issue_Date as "Issue Date"
				Due_Date as "Due Date"
				Return_Date as "Return Date"
				Issue_Status as "Issue Status"
				Single_Line as "Remarks"
			)
		}
		list Currently_Issued
		{
			displayName = "Currently Issued"
			show all rows from Book_Issues  [Issue_Status != "Returned"]  
			(
				Issue_ID as "Issue ID"
				Member
				Book
				Issue_Date as "Issue Date"
				Due_Date as "Due Date"
				Return_Date as "Return Date"
				Issue_Status as "Issue Status"
				Single_Line as "Remarks"
			)
		}
		list Returned_Books
		{
			displayName = "Returned Books"
			show all rows from Book_Issues  [Issue_Status == "Returned"]  
			(
				Issue_ID as "Issue ID"
				Member
				Book
				Issue_Date as "Issue Date"
				Due_Date as "Due Date"
				Return_Date as "Return Date"
				Issue_Status as "Issue Status"
				Single_Line as "Remarks"
			)
		}
		list Overdue_Books
		{
			displayName = "Overdue Books"
			show all rows from Book_Issues  [Issue_Status == "Overdue" || (Issue_Status == "Issued" && Due_Date < zoho.currentdate)]  
			(
				Issue_ID as "Issue ID"
				Member
				Book
				Issue_Date as "Issue Date"
				Due_Date as "Due Date"
				Return_Date as "Return Date"
				Issue_Status as "Issue Status"
				Single_Line as "Remarks"
			)
		}
	}
	pages
	{
		page Library_Dashboard
		{
			displayname = "Library Dashboard"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='33%'\n   \t>\n\t<panel elementName='Total_Titles_KPI'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#1E88E5'\n\tsize = '36px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n    borderColor = '#1E88E5'\n    borderWidth = '0px'\n\n\t  value = 'thisapp.Books.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#333333'\n    borderWidth = '0px'\n\n\t  value = 'Total Book Titles'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='33%'\n   \t>\n\t<panel elementName='Total_Members_KPI'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#6A1B9A'\n\tsize = '36px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n    borderColor = '#6A1B9A'\n    borderWidth = '0px'\n\n\t  value = 'thisapp.Members.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#333333'\n    borderWidth = '0px'\n\n\t  value = 'Total Members'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='33%'\n   \t>\n\t<panel elementName='Available_Copies_KPI'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#2E7D32'\n\tsize = '36px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n    borderColor = '#2E7D32'\n    borderWidth = '0px'\n\n\t  value = 'thisapp.Books.Available_Copies.sum'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#333333'\n    borderWidth = '0px'\n\n\t  value = 'Total Available Copies'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='50%'\n   \t>\n\t<panel elementName='Currently_Issued_KPI'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#EF6C00'\n\tsize = '36px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n    borderColor = '#EF6C00'\n    borderWidth = '0px'\n\n\t\tcriteria = 'Issue_Status != &quot;Returned&quot;'\n\t  value = 'thisapp.Book_Issues.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#333333'\n    borderWidth = '0px'\n\n\t  value = 'Books Currently Issued'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='50%'\n   \t>\n\t<panel elementName='Overdue_KPI'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#C62828'\n\tsize = '36px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n    borderColor = '#C62828'\n    borderWidth = '0px'\n\n\t\tcriteria = 'Issue_Status == &quot;Overdue&quot;'\n\t  value = 'thisapp.Book_Issues.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#333333'\n    borderWidth = '0px'\n\n\t  value = 'Overdue Books'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='50%'\n   \t>\n\t<chart \n\telementName='Issues_by_Status'\n\n\ttype = 'Pie'\n\tbgColor = '#FFFFFF'\n\ttheme = 'theme1'\n\tlegendPos = 'center.top'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'Book_Issues'\n\txfield = 'Issue_Status'\n\tyfields = 'count:Issue_ID'\n/>\n\n</column><column\n   \t\t width='50%'\n   \t>\n\t<chart \n\telementName='Available_Copies_by_Category'\n\n\ttype = 'Column'\n\txtitle = 'Category'\n\tytitle = 'Available Copies'\n\tbgColor = '#FFFFFF'\n\ttheme = 'theme1'\n\tlegendPos = 'center.top'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'Books'\n\txfield = 'Category'\n\tyfields = 'sum:Available_Copies'\n/>\n\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<report \n\telementName='Currently_Issued_Report'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'Currently_Issued'\n\t\n\t\tiszreport = 'false'\n\theightType = 'auto'\n\theightValue = '500'\n/>\n</column>\n</row>\n</layout>\n</zml>"
		}
	}


		 functions
		 {
			 Deluge
			 {
				 void loadSampleData()
                 {
                 	// one-time load of the sample library catalogue and members
                 	insert into Books
                 	[
                 		Added_User=zoho.loginuser
                 		ISBN="9780132350884"
                 		Book_Title="Clean Code"
                 		Author="Robert C. Martin"
                 		Category="Technology"
                 		Publisher="Prentice Hall"
                 		Total_Copies=3
                 		Available_Copies=3
                 		Single_Line="T-01"
                 	]
                 	insert into Books
                 	[
